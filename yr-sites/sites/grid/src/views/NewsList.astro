---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { t, lp, fmtDate, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const posts = (await getCollection('news', (e) => e.data.status === 'published' && e.data.lang === lang)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base lang={lang} title={s.news_title} description={s.news_lede} current="/news/">
  <PageHead title={s.news_title} lede={s.news_lede} />
  <section class="wrap n">
    {posts.length === 0 && <p class="mute">{lang === 'zh' ? '暂无文章。' : 'No articles yet.'}</p>}
    <ul>{posts.map((p) => <li><time class="mute" datetime={p.data.date.toISOString()}>{fmtDate(lang, p.data.date)}</time><div><h2><a href={lp(lang, `/news/${p.id.replace(/^zh\//, '')}/`)}>{p.data.title}</a></h2><p>{p.data.description}</p></div></li>)}</ul>
  </section>
</Base>
<style>.n{padding-top:32px;padding-bottom:72px}.n ul{list-style:none;padding:0;margin:0}.n li{display:grid;grid-template-columns:160px 1fr;gap:24px;padding:24px 0;border-bottom:1px solid var(--line)}.n h2{font-size:1.6rem;margin:0 0 6px}.n h2 a{color:var(--ink);text-decoration:none}.n h2 a:hover{text-decoration:underline}.n p{margin:0}@media(max-width:600px){.n li{grid-template-columns:1fr;gap:4px}}</style>
