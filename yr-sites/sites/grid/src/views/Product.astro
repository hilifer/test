---
import Base from '../layouts/Base.astro';
import Illus from '../components/Illus.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import catalog from '../data/catalog.json';
import site from '../data/site.json';
import { productJsonLd, faqJsonLd } from '../../../../shared/site-lib.mjs';
import { t, lp, pick, specZh, type Lang } from '../i18n';
const { lang, p } = Astro.props as { lang: Lang; p: any };
const s = t(lang);
const zh = lang === 'zh';
const cat = catalog.categories.find((c) => c.id === p.category)!;
const name = pick(lang, p.name, p.nameZh);
const related = catalog.products.filter((x) => x.category === p.category && x.id !== p.id).slice(0, 3);
const lo = Math.min(...p.priceBands.map((b: any) => b.low)), hi = Math.max(...p.priceBands.map((b: any) => b.high));
const faq = zh
  ? [
      { q: `${name}的起订量是多少？`, a: `${p.moq} ${p.moq === 1 ? p.unit.replace(/s\b/, '') : p.unit}。样品约 ${p.sampleDays[0]}–${p.sampleDays[1]} 天。` },
      { q: '交期多久？', a: `生产交期 ${p.leadTimeDays[0]}–${p.leadTimeDays[1]} 天，视数量和配置而定。` },
      { q: '有哪些认证？', a: `${p.certifications.join('、')}。证书和测试报告可按需提供。` },
      { q: `${name}多少钱？`, a: `参考价 ${catalog.currency} ${lo.toLocaleString('en-US')}–${hi.toLocaleString('en-US')}（${catalog.priceTerm}），视配置和数量而定，仅供参考，以正式 PI 为准。` },
    ]
  : [
      { q: `What is the MOQ for the ${p.name}?`, a: `${p.moq} ${p.moq === 1 ? p.unit.replace(/s\b/, '') : p.unit}. Samples take about ${p.sampleDays[0]}–${p.sampleDays[1]} days.` },
      { q: 'What is the lead time?', a: `Production lead time is ${p.leadTimeDays[0]}–${p.leadTimeDays[1]} days depending on quantity and configuration.` },
      { q: `Which certifications does the ${p.name} have?`, a: `${p.certifications.join(', ')}. Certificates and test reports are available on request.` },
      { q: `How much does the ${p.name} cost?`, a: `Reference prices range from ${catalog.currency} ${lo.toLocaleString('en-US')} to ${hi.toLocaleString('en-US')} (${catalog.priceTerm}) depending on configuration and quantity. ${catalog.priceNote}` },
    ];
const ld = [productJsonLd({ site: Astro.site!.href, brand: site.brand, catalog, p, lang }), faqJsonLd(faq)];
const hl = pick(lang, p.highlights, p.highlightsZh) as string[];
---
<Base lang={lang} title={name} description={`${pick(lang, p.summary, p.summaryZh)} ${p.certifications.join(', ')}. ${s.moq} ${p.moq} ${p.moq === 1 ? p.unit.replace(/s\b/, '') : p.unit}.`} markdown={`/products/${p.slug}.md`} jsonld={ld} current="/products/">
  <div class="wrap crumbs"><a href={lp(lang, '/products/')}>{s.nav_products}</a> / <a href={`${lp(lang, '/products/')}#${cat.id}`}>{pick(lang, cat.name, cat.nameZh)}</a></div>
  <section class="wrap pd">
    <div class="pd__img">{p.image ? <img src={p.image} alt={name} /> : <Illus kind={p.illus} label={name} />}</div>
    <div>
      <h1>{name}</h1>
      <p class="lede">{pick(lang, p.summary, p.summaryZh)}</p>
      <ul class="hl">{hl.map((h) => <li>{h}</li>)}</ul>
      <ul class="certs" aria-label={s.certs}>{p.certifications.map((c: string) => <li class="tag">{c}</li>)}</ul>
      <dl class="order num">
        <div><dt>{s.moq}</dt><dd>{p.moq} {p.moq === 1 ? p.unit.replace(/s\b/, '') : p.unit}</dd></div>
        <div><dt>{s.lead}</dt><dd>{p.leadTimeDays[0]}–{p.leadTimeDays[1]} {s.days}</dd></div>
        <div><dt>{s.samples}</dt><dd>{p.sampleDays[0]}–{p.sampleDays[1]} {s.days}</dd></div>
        <div><dt>{s.warranty}</dt><dd>{p.warranty}</dd></div>
      </dl>
      <div class="actions">
        <button class="btn btn--lime" data-chat-open data-chat-prompt={zh ? `我想了解 ${name}，按我的数量报个参考价。` : `I'm interested in the ${p.name}. What's the price for my quantity?`}>{s.instant}</button>
        <a class="btn btn--line" href="#quote">{s.formal}</a>
      </div>
    </div>
  </section>
  <section class="wrap cols">
    <div>
      <h2>{s.specs}</h2>
      <table class="spec num"><tbody>{Object.entries(p.specs).map(([k, v]) => <tr><th scope="row">{zh ? specZh[k] || k : k}</th><td>{v as string}</td></tr>)}</tbody></table>
      <p class="mute md">{s.mdv}: <a href={`/products/${p.slug}.md`}>{p.slug}.md</a></p>
    </div>
    <aside>
      <h2>{s.refprice}</h2>
      <table class="spec num"><thead><tr><th scope="col">{s.qty}</th><th scope="col">{s.unitprice} ({catalog.currency})</th></tr></thead>
        <tbody>{p.priceBands.map((b: any) => <tr><td>{b.minQty}{b.maxQty ? `–${b.maxQty}` : '+'} {p.unit}</td><td>{b.low.toLocaleString('en-US')}–{b.high.toLocaleString('en-US')}</td></tr>)}</tbody></table>
      <p class="mute small">{catalog.priceTerm}. {s.price_note_long} {zh ? '以上仅供参考，以正式 PI 为准。' : catalog.priceNote}</p>
      <h2 class="faqh">{s.faq}</h2>
      <dl class="faq">{faq.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl>
    </aside>
  </section>
  <section class="section section--white" id="quote">
    <div class="wrap quote"><div><h2>{s.q_title}</h2><p>{s.q_lede}</p></div><QuoteForm lang={lang} productId={p.id} /></div>
  </section>
  {related.length > 0 && <section class="wrap rel"><h2>{s.alsoin} {pick(lang, cat.name, cat.nameZh)}</h2><div class="cards">{related.map((r) => <ProductCard p={r} lang={lang} />)}</div></section>}
</Base>
<style>
  .crumbs{padding-top:22px;font-size:14.5px;color:var(--steel)}.crumbs a{color:var(--steel)}
  .pd{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(24px,5vw,64px);padding-top:18px;padding-bottom:48px;align-items:start}
  .pd__img{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:32px;position:sticky;top:100px}
  .pd h1{font-size:clamp(2.2rem,4.2vw,3.4rem)}
  .hl{padding-left:1.1em;margin:0 0 16px}.certs{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-wrap:wrap;gap:6px}
  .order{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:10px;overflow:hidden;margin:0 0 24px}
  .order div{background:var(--surface);padding:12px 14px}.order dt{font-size:13px;color:var(--steel)}.order dd{margin:2px 0 0;font-weight:600}
  .actions{display:flex;gap:12px;flex-wrap:wrap}
  .cols{display:grid;grid-template-columns:1.3fr 1fr;gap:48px;padding-bottom:64px}.cols h2{font-size:1.9rem}
  .cols table{background:var(--surface);border:1px solid var(--line)}.cols thead th{width:auto;background:#eaf2f5}
  .small,.md{font-size:14px;margin-top:10px}.faqh{margin-top:32px}.faq dt{font-weight:600;margin-top:14px}.faq dd{margin:4px 0 0;color:var(--ink-2);font-size:15.5px}
  .quote{display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:start}
  .rel{padding-top:56px;padding-bottom:72px}.rel .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:18px}
  @media(max-width:900px){.pd,.cols,.quote{grid-template-columns:1fr}.pd__img{position:static}.order{grid-template-columns:repeat(2,1fr)}}
</style>
