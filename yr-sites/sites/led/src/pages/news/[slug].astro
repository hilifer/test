---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, render } from 'astro:content';
import catalog from '../../data/catalog.json';
import site from '../../data/site.json';
import { faqJsonLd } from '../../../../../shared/site-lib.mjs';
export async function getStaticPaths() {
  const posts = await getCollection('news', (e) => e.data.status === 'published');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const prods = catalog.products.filter((p) => d.products.includes(p.id));
const article = { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, datePublished: d.date.toISOString(), dateModified: (d.updated || d.date).toISOString(), author: { '@type': 'Organization', name: site.brandFull }, publisher: { '@type': 'Organization', name: site.brandFull }, mainEntityOfPage: new URL(`/news/${entry.id}/`, Astro.site).href };
const ld = [article, faqJsonLd(d.faq)].filter(Boolean);
---
<Base title={d.title} description={d.description} markdown={`/news/${entry.id}.md`} jsonld={ld as object[]} current="/news/">
  <article class="wrap art">
    <p class="crumbs"><a href="/news/">Guides and news</a></p>
    <h1>{d.title}</h1>
    <p class="meta mute">
      <time datetime={d.date.toISOString()}>{d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      {d.updated && <span>Updated <time datetime={d.updated.toISOString()}>{d.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>}
    </p>
    <p class="lede">{d.description}</p>
    <div class="prose"><Content /></div>
    {d.faq.length > 0 && (
      <section class="faq"><h2>Frequently asked questions</h2>{d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    )}
    {d.sources.length > 0 && (<section class="src"><h2>Sources</h2><ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener nofollow">{s.title}</a></li>)}</ul></section>)}
  </article>
  {prods.length > 0 && (<section class="wrap rel"><h2>Products mentioned</h2><div class="cards">{prods.map((p) => <ProductCard p={p} />)}</div></section>)}
</Base>
<style>
  .art{max-width:820px;padding-top:28px;padding-bottom:40px}
  .crumbs{font-size:14.5px}.meta{display:flex;gap:16px;font-size:14.5px}
  .art h1{font-size:clamp(2rem,4.2vw,3rem)}
  .faq{margin-top:40px}.faq details{border-top:1px solid var(--line);padding:12px 0}.faq summary{font-weight:650;cursor:pointer}.faq p{margin:8px 0 0}
  .src{margin-top:32px;font-size:15px}
  .rel{padding-bottom:72px}.rel .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px}
</style>
