# ===== YR GRID 光储充站 · 东南亚（新加坡）服务器 =====
# 复制为 .env 后填写。带 * 的为必填。
SITE=grid
# * 域名（不带 https://，先把 A 记录指向本服务器 IP）
DOMAIN=www.example-grid.com
# * 后台登录：https://域名/admin
ADMIN_USER=admin
ADMIN_PASSWORD=请改成强密码

# ---- AI 销售对话（不填则使用内置规则答复）----
# 方案一：Anthropic Claude
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# 方案二：任意 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问国际版等）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# ---- 线索告警 ----
# 企业微信群机器人 Webhook（群设置 → 群机器人 → 添加）
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
# 通用 Webhook（可接 Zapier/Make → 邮件/CRM）
ALERT_WEBHOOK_URL=
# 达到哪个等级才告警：A / B / C / D
ALERT_MIN_GRADE=B

# ---- SEO/GEO 内容智能体 ----
CONTENT_ENABLED=true
# 每周几运行（0=周日…6=周六）、几点（按 CONTENT_TZ）
CONTENT_DAYS=1,3,5
CONTENT_HOUR=9
CONTENT_TZ=Asia/Shanghai
CONTENT_POSTS_PER_RUN=1
CONTENT_LANGS=en,zh
# false = 草稿进后台待审核（建议上线前 1–2 个月保持 false）
CONTENT_AUTO_PUBLISH=false
# Write an SEO/GEO article automatically for each newly published product (true/false)
CONTENT_PROMOTE_NEW=true
# 写稿可单独用一个模型（不填则沿用上面的 LLM_*）
CONTENT_LLM_PROVIDER=
CONTENT_LLM_API_KEY=
CONTENT_LLM_BASE_URL=
CONTENT_LLM_MODEL=
# IndexNow 密钥：任意 32 位字母数字，生成后不要改
INDEXNOW_KEY=

# ---- GEO 监测（每周问一遍 AI 搜索，看我们是否被提及）----
GEO_ENABLED=true
GEO_DAY=1
GEO_HOUR=10
# 建议用带联网搜索的 OpenAI 兼容接口，例如 Perplexity
GEO_LLM_PROVIDER=openai
GEO_LLM_BASE_URL=https://api.perplexity.ai
GEO_LLM_API_KEY=
GEO_LLM_MODEL=sonar

# ---- 金蝶云星空对接（订单推送 / 即时库存）----
# local = 不接 ERP，在后台 SKU 中心维护库存；mock = 模拟金蝶（测试用）；kingdee = 真实对接
ERP_MODE=local
ERP_SYNC_MINUTES=60
ERP_AUTO_PUSH_ORDERS=true
# 金蝶云星空地址，例如 https://xxx.ik3cloud.com/k3cloud（私有部署需公网可访问或配置 VPN）
KD_BASE_URL=
# 数据中心 ID、集成用户
KD_ACCT_ID=
KD_USERNAME=
# 推荐：第三方系统登录授权（管理中心 → 第三方系统登录授权 获取应用 ID 和密钥）
KD_APP_ID=
KD_APP_SECRET=
# 或使用用户密码登录
KD_PASSWORD=
KD_LCID=2052
# 销售组织 / 库存组织编码
KD_ORG_NUMBER=100
KD_SO_BILLTYPE=XSDD01_SYS
# 币别编码（按贵司金蝶基础资料核对）
KD_CUR_USD=PRE007
KD_CUR_CNY=PRE001
# 只同步部分仓库（可选），例如 FStockId.FNumber IN ('CK001','CK002')
KD_STOCK_FILTER=

RATE_LIMIT_PER_MIN=20

# ---- 网店：在线支付（不填则只显示"银行电汇"）----
# Stripe（银行卡 / Apple Pay / Google Pay）：Stripe 后台 → Developers → API keys / Webhooks
# Webhook 地址填 https://域名/api/pay/stripe/webhook，事件选 checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal：developer.paypal.com → Apps & Credentials；正式环境把 API 地址改为 https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- 邮件（注册验证、找回密码、订单通知）----
# 例：smtps://用户名:密码@smtp.qiye.aliyun.com:465 ；不填则邮件只保存在后台"网店 → 最近邮件"
SMTP_URL=
MAIL_FROM=

# ---- 物流轨迹自动跟踪（17TRACK，api.17track.net 注册获取）----
# 填写后：发货单有运单号即自动注册，每 2 小时更新一次物流状态并邮件通知网店客户
TRACK17_KEY=

# Database backups (daily snapshot + restore check). Off-site copy strongly recommended, e.g. rclone copy {file} oss:yr-backups
BACKUP_HOUR=3
BACKUP_KEEP=14
BACKUP_CMD=

# ---- AI image service for cutout / background replacement in the asset library (optional)
# remove.bg API key; set IMAGE_AI_BASE_URL only for a compatible self-hosted / other service
IMAGE_AI_KEY=
# IMAGE_AI_BASE_URL=https://api.remove.bg

# ---- Ops: status of the other site on the "Both sites" page (same OPS_TOKEN on both sites)
# PEER_SITES=led|https://yaorong-led.example.com
# OPS_TOKEN=
