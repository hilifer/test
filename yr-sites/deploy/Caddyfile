{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# AI sales backend, MCP endpoint, customer portal and admin
	@app path /api/* /mcp /admin /admin/* /portal /portal/* /media/* /shop /shop/*
	handle @app {
		reverse_proxy app:8787
	}

	# Static site (current release, swapped atomically by the content agent)
	handle {
		root * /srv/site/current
		@md path *.md
		header @md Content-Type "text/markdown; charset=utf-8"
		@llms path /llms.txt /llms-full.txt
		header @llms Content-Type "text/plain; charset=utf-8"
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		header /brand/* Cache-Control "public, max-age=604800"
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			root * /srv/site/current
			rewrite * /404.html
			file_server
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
